<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<BaseOutputPath>Binaries\</BaseOutputPath>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		
		<AssetPath>Assets</AssetPath>
		<AssetPackStamp>$(IntermediateOutputPath)assets.pack.stamp</AssetPackStamp>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nitor\Nitor.csproj" />
		<ProjectReference Include="..\AssetPacker\AssetPacker.csproj" ReferenceOutputAssembly="false" Private="false" />
	</ItemGroup>

	<ItemGroup>
		<AssetFiles Include="$(AssetPath)\**\*" />
		<UpToDateCheckInput Include="@(AssetFiles)" />
		<UpToDateCheckOutput Include="$(AssetPackStamp)" />
	</ItemGroup>


	<Target Name="PackAssets" BeforeTargets="Build" Inputs="@(AssetFiles)" Outputs="$(AssetPackStamp)">

		<Message Text="Packing assets..." Importance="high" />

		<MSBuild Projects="..\AssetPacker\AssetPacker.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
			<Output TaskParameter="TargetOutputs" ItemName="AssetPackerOutput" />
		</MSBuild>

		<Exec Command="dotnet &quot;@(AssetPackerOutput)&quot; &quot;$(MSBuildProjectDirectory)\$(AssetPath)&quot; &quot;$(TargetDir).&quot;" />

	</Target>

</Project>
